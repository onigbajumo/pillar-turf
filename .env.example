# MongoDB connection string. For local development run `npm run db:local`
# and keep this value. For production use your MongoDB Atlas URI.
MONGODB_URI=mongodb://127.0.0.1:27017/pillars-turf

# Long random string used to sign admin login sessions.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=change-me-to-a-long-random-string

# Cloudinary (Dashboard > Settings > API Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Folder that team photos and award media are stored under
CLOUDINARY_FOLDER=pillars-turf
